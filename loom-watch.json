{
  "version": 1,
  "label": "loom-feedback",
  "escalate_label": "needs-human",
  "title": "issue {issue}",
  "cap": 2,
  "stuck": "2h",
  "nudge_limit": 3,
  "nudge_gap": "1h",
  "issue_changed": true,
  "log_tail": 200,
  "session": {
    "model": "opus",
    "effort": "high",
    "permission_mode": "auto",
    "account": "",
    "prompt": ".loom-watch/start.md",
    "resume_prompt": ".loom-watch/resume.md"
  }
}
